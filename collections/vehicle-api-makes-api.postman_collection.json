          "request": {
            "name": "Vehicle API List Makes",
            "description": {
              "content": "Returns a list of all vehicle makes (manufacturers). Supports filtering by publication state, vehicle type, and year. Returns make ID, name, nice name (URL-friendly slug), and model count.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicle",
                "v2",
                "makes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Publication state filter: new, used, or future"
                },
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<integer>",
                  "description": "Filter by model year (4-digit year)"
                },
                {
                  "disabled": false,
                  "key": "view",
                  "value": "basic",
                  "description": "Response detail level: basic or full"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Edmunds API key"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null

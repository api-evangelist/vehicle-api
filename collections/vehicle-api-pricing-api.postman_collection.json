          "name": "Vehicle API Get TMV Price",
          "request": {
            "name": "Vehicle API Get TMV Price",
            "description": {
              "content": "Returns True Market Value (TMV) pricing for a vehicle style. TMV is Edmunds' estimate of what consumers are actually paying for a vehicle in a given area. Supports new and used vehicle pricing with zip code localization.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicle",
                "v2",
                "price",
                "tmv",
                "simple"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "styleId",
                  "value": "<integer>",
                  "description": "(Required) Edmunds style ID"
                },
                {
                  "disabled": false,
                  "key": "zip",
                  "value": "<string>",
                  "description": "(Required) 5-digit US ZIP code for regional pricing"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "new",
                  "description": "Vehicle condition: new or used"
                },
                {
                  "disabled": false,
                  "key": "mileage",
                  "value": "<integer>",
                  "description": "Mileage for used vehicle valuation"
                },
                {
                  "disabled": false,
                  "key": "condition",
                  "value": "<string>",
                  "description": "Used vehicle condition: Outstanding, Clean, Average, Rough"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Edmunds API key"
                }
              ],
              "variable": []
            },

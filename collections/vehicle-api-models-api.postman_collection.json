          "name": "Vehicle API List Models",
          "request": {
            "name": "Vehicle API List Models",
            "description": {
              "content": "Returns all models for a given vehicle make. Supports filtering by publication state and year. Returns model ID, name, nice name, and the parent make.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicle",
                "v2",
                "makes",
                ":makeNiceName",
                "models"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Publication state: new, used, or future"
                },
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<integer>",
                  "description": "Filter by model year"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Edmunds API key"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "makeNiceName",
                  "description": "(Required) URL-friendly make name (e.g. toyota, ford, chevrolet)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

                  "description": "Search radius in miles (default 50)"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "25",
                  "description": "Results per page (max 100)"
                },
                {
                  "disabled": false,
                  "key": "pageNum",
                  "value": "1",
                  "description": "Page number (1-based)"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Edmunds API key"
